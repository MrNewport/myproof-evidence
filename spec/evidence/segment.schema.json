{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "ulid": {
            "type": "string",
            "minLength": 26,
            "maxLength": 26,
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
        },
        "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "opaque": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        "uint": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
        },
        "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
        },
        "currency_exponent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
        },
        "edge_request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_+=/-]{1,128}$"
        },
        "nullable_uint": {
            "type": [
                "integer",
                "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
        },
        "http_status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
        },
        "edge_status": {
            "oneOf": [
                {
                    "const": 0
                },
                {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                }
            ]
        },
        "bool": {
            "type": "boolean"
        }
    },
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "export_id",
        "workspace_id",
        "delivery_id",
        "mode",
        "privacy_mode",
        "index",
        "chain_start",
        "chain_head",
        "events_sha256",
        "events_bytes",
        "event_count",
        "artifacts"
    ],
    "properties": {
        "schema": {
            "const": "myproof.evidence.segment.v1"
        },
        "export_id": {
            "$ref": "#/$defs/ulid"
        },
        "workspace_id": {
            "$ref": "#/$defs/ulid"
        },
        "delivery_id": {
            "$ref": "#/$defs/ulid"
        },
        "mode": {
            "enum": [
                "demo",
                "test",
                "live"
            ]
        },
        "privacy_mode": {
            "enum": [
                "masked",
                "full_private"
            ]
        },
        "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
        },
        "chain_start": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "sequence",
                "previous_sha256"
            ],
            "properties": {
                "sequence": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 512000
                },
                "previous_sha256": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "#/$defs/hash"
                        }
                    ]
                }
            }
        },
        "chain_head": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "sequence",
                "sha256"
            ],
            "properties": {
                "sequence": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 512000
                },
                "sha256": {
                    "$ref": "#/$defs/hash"
                }
            }
        },
        "events_sha256": {
            "$ref": "#/$defs/hash"
        },
        "events_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4194304
        },
        "event_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
        },
        "artifacts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "name",
                    "sha256",
                    "size"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}\\.(json|html|pdf|txt)$",
                        "not": {
                            "enum": [
                                "segment.json",
                                "collection.json"
                            ]
                        }
                    },
                    "sha256": {
                        "$ref": "#/$defs/hash"
                    },
                    "size": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 8388608
                    }
                }
            }
        }
    },
    "title": "MyProof evidence segment v1",
    "allOf": [
        {
            "if": {
                "properties": {
                    "chain_start": {
                        "properties": {
                            "sequence": {
                                "const": 1
                            }
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "chain_start": {
                        "properties": {
                            "previous_sha256": {
                                "type": "null"
                            }
                        }
                    }
                }
            },
            "else": {
                "properties": {
                    "chain_start": {
                        "properties": {
                            "previous_sha256": {
                                "$ref": "#/$defs/hash"
                            }
                        }
                    }
                }
            }
        }
    ],
    "$comment": "Structural schema only. Strict canonical byte/token profile, UTF-8 byte bounds, summed artifact bounds, unique names/sources, range arithmetic, ordered descriptors, path/index equality, original v2 chain checks, digest and signature verification are mandatory protocol checks."
}
