{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "ulid": {
            "type": "string",
            "minLength": 26,
            "maxLength": 26,
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
        },
        "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "opaque": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        "uint": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
        },
        "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
        },
        "currency_exponent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
        },
        "edge_request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_+=/-]{1,128}$"
        },
        "nullable_uint": {
            "type": [
                "integer",
                "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
        },
        "http_status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
        },
        "edge_status": {
            "oneOf": [
                {
                    "const": 0
                },
                {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                }
            ]
        },
        "bool": {
            "type": "boolean"
        }
    },
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "event_id",
        "workspace_id",
        "delivery_id",
        "sequence",
        "previous_hash",
        "occurred_at",
        "recorded_at",
        "source",
        "source_event_id",
        "type",
        "mode",
        "payload",
        "private_context_ref"
    ],
    "properties": {
        "schema": {
            "const": "myproof.evidence.v2"
        },
        "event_id": {
            "$ref": "#/$defs/ulid"
        },
        "workspace_id": {
            "$ref": "#/$defs/ulid"
        },
        "delivery_id": {
            "$ref": "#/$defs/ulid"
        },
        "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
        },
        "previous_hash": {
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "$ref": "#/$defs/hash"
                }
            ]
        },
        "occurred_at": {
            "$ref": "#/$defs/timestamp"
        },
        "recorded_at": {
            "$ref": "#/$defs/timestamp"
        },
        "source": {
            "enum": [
                "app",
                "merchant",
                "stripe",
                "ses",
                "cloudfront",
                "client"
            ]
        },
        "source_event_id": {
            "$ref": "#/$defs/opaque"
        },
        "type": {
            "enum": [
                "order_snapshot_recorded",
                "payment_observed",
                "payment_provider_observed",
                "portal_requested",
                "delivery_access_changed",
                "code_message_accepted",
                "email_code_verified",
                "download_authorized",
                "edge_response_observed",
                "browser_receipt_reported",
                "preview_reported",
                "access_acknowledged",
                "help_requested",
                "transfer_problem_reported"
            ]
        },
        "mode": {
            "enum": [
                "demo",
                "test",
                "live"
            ]
        },
        "payload": {
            "type": "object"
        },
        "private_context_ref": {
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "$ref": "#/$defs/ulid"
                }
            ]
        }
    },
    "title": "MyProof evidence v2 event",
    "oneOf": [
        {
            "properties": {
                "type": {
                    "const": "order_snapshot_recorded"
                },
                "source": {
                    "enum": [
                        "app",
                        "merchant"
                    ]
                },
                "payload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "snapshot_sha256",
                        "asset_version_id",
                        "order_id"
                    ],
                    "properties": {
                        "snapshot_sha256": {
                            "$ref": "#/$defs/hash"
                        },
                        "asset_version_id": {
                            "$ref": "#/$defs/ulid"
                        },
                        "order_id": {
                            "$ref": "#/$defs/ulid"
                        }
                    }
                }
            }
        },
        {
            "properties": {
                "type": {
                    "const": "payment_observed"
                },
                "source": {
                    "enum": [
                        "stripe",
                        "merchant"
                    ]
                },
                "payload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "status",
                        "amount_minor",
                        "currency",
                        "currency_exponent"
                    ],
                    "properties": {
                        "status": {
                            "enum": [
                                "pending",
                                "paid",
                                "failed",
                                "refunded",
                                "partially_refunded",
                                "disputed",
                                "unknown"
                            ]
                        },
                        "amount_minor": {
                            "$ref": "#/$defs/uint"
                        },
                        "currency": {
                            "$ref": "#/$defs/currency"
                        },
                        "currency_exponent": {
                            "$ref": "#/$defs/currency_exponent"
                        }
                    }
                }
            }
        },
        {
            "properties": {
                "type": {
                    "const": "payment_provider_observed"
                },
                "source": {
                    "enum": [
                        "stripe"
                    ]
                },
                "payload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "account_id",
                        "payment_intent_id",
                        "order_id",
                        "order_snapshot_sha256",
                        "status",
                        "amount_minor",
                        "currency",
                        "currency_exponent",
                        "refunded_minor",
                        "refund_pending",
                        "dispute_status",
                        "observed_at",
                        "trigger_created_at",
                        "mapping_source"
                    ],
                    "properties": {
                        "account_id": {
                            "$ref": "#/$defs/opaque"
                        },
                        "payment_intent_id": {
                            "$ref": "#/$defs/opaque"
                        },
                        "order_id": {
                            "$ref": "#/$defs/ulid"
                        },
                        "order_snapshot_sha256": {
                            "$ref": "#/$defs/hash"
                        },
                        "status": {
                            "enum": [
                                "pending",
                                "paid",
                                "failed",
                                "refunded",
                                "partially_refunded",
                                "disputed"
                            ]
                        },
                        "amount_minor": {
                            "$ref": "#/$defs/uint"
                        },
                        "currency": {
                            "$ref": "#/$defs/currency"
                        },
                        "currency_exponent": {
                            "$ref": "#/$defs/currency_exponent"
                        },
                        "refunded_minor": {
                            "$ref": "#/$defs/uint"
                        },
                        "refund_pending": {
                            "$ref": "#/$defs/bool"
                        },
                        "dispute_status": {
                            "enum": [
                                "none",
                                "open",
                                "won",
                                "lost"
                            ]
                        },
                        "observed_at": {
                            "$ref": "#/$defs/timestamp"
                        },
                        "trigger_created_at": {
                            "$ref": "#/$defs/timestamp"
                        },
                        "mapping_source": {
                            "enum": [
                                "merchant"
                            ]
                        }
                    }
                }
            }
        },
        {
            "properties": {
                "type": {
                    "const": "portal_requested"
                },
                "source": {
                    "enum": [
                        "app"
                    ]
                },
                "payload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [],
                    "properties": {}
                }
            }
        },
        {
            "properties": {
                "type": {
                    "const": "delivery_access_changed"
                },
                "source": {
                    "enum": [
                        "app"
                    ]
                },
                "payload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "change",
                        "generation",
                        "residual_url_seconds"
                    ],
                    "properties": {
                        "change": {
                            "enum": [
                                "rotated",
                                "revoked"
                            ]
                        },
                        "generation": {
                            "$ref": "#/$defs/uint"
                        },
                        "residual_url_seconds": {
                            "$ref": "#/$defs/uint"
                        }
                    }
                }
            }
        },
        {
            "properties": {
                "type": {
                    "const": "code_message_accepted"
                },
                "source": {
                    "enum": [
                        "ses"
                    ]
                },
                "payload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "purpose"
                    ],
                    "properties": {
                        "purpose": {
                            "enum": [
                                "delivery_access"
                            ]
                        }
                    }
                }
            }
        },
        {
            "properties": {
                "type": {
                    "const": "email_code_verified"
                },
                "source": {
                    "enum": [
                        "app"
                    ]
                },
                "payload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "method"
                    ],
                    "properties": {
                        "method": {
                            "enum": [
                                "email_code"
                            ]
                        }
                    }
                }
            }
        },
        {
            "properties": {
                "type": {
                    "const": "download_authorized"
                },
                "source": {
                    "enum": [
                        "app"
                    ]
                },
                "payload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "attempt_id",
                        "asset_version_id",
                        "expires_at",
                        "receipt_mode"
                    ],
                    "properties": {
                        "attempt_id": {
                            "$ref": "#/$defs/ulid"
                        },
                        "asset_version_id": {
                            "$ref": "#/$defs/ulid"
                        },
                        "expires_at": {
                            "$ref": "#/$defs/timestamp"
                        },
                        "receipt_mode": {
                            "enum": [
                                "native",
                                "browser_checksum"
                            ]
                        }
                    }
                }
            }
        },
        {
            "properties": {
                "type": {
                    "const": "edge_response_observed"
                },
                "source": {
                    "enum": [
                        "cloudfront"
                    ]
                },
                "payload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "attempt_id",
                        "asset_version_id",
                        "object_identity_sha256",
                        "distribution_id",
                        "request_id",
                        "log_source_id",
                        "method",
                        "status_code",
                        "bytes_sent",
                        "bytes_semantics",
                        "response_content_length",
                        "response_range_start",
                        "response_range_end",
                        "response_result_type",
                        "final_result_type",
                        "detailed_result_type"
                    ],
                    "properties": {
                        "attempt_id": {
                            "$ref": "#/$defs/ulid"
                        },
                        "asset_version_id": {
                            "$ref": "#/$defs/ulid"
                        },
                        "object_identity_sha256": {
                            "$ref": "#/$defs/hash"
                        },
                        "distribution_id": {
                            "$ref": "#/$defs/opaque"
                        },
                        "request_id": {
                            "$ref": "#/$defs/edge_request_id"
                        },
                        "log_source_id": {
                            "$ref": "#/$defs/opaque"
                        },
                        "method": {
                            "enum": [
                                "GET",
                                "HEAD",
                                "OPTIONS"
                            ]
                        },
                        "status_code": {
                            "$ref": "#/$defs/edge_status"
                        },
                        "bytes_sent": {
                            "$ref": "#/$defs/uint"
                        },
                        "bytes_semantics": {
                            "enum": [
                                "response_including_headers"
                            ]
                        },
                        "response_content_length": {
                            "$ref": "#/$defs/nullable_uint"
                        },
                        "response_range_start": {
                            "$ref": "#/$defs/nullable_uint"
                        },
                        "response_range_end": {
                            "$ref": "#/$defs/nullable_uint"
                        },
                        "response_result_type": {
                            "enum": [
                                "Hit",
                                "RefreshHit",
                                "Miss",
                                "LimitExceeded",
                                "CapacityExceeded",
                                "Error",
                                "Redirect",
                                "LambdaExecutionError",
                                "Unknown"
                            ]
                        },
                        "final_result_type": {
                            "enum": [
                                "Hit",
                                "RefreshHit",
                                "Miss",
                                "LimitExceeded",
                                "CapacityExceeded",
                                "Error",
                                "Redirect",
                                "LambdaExecutionError",
                                "Unknown"
                            ]
                        },
                        "detailed_result_type": {
                            "enum": [
                                "Hit",
                                "RefreshHit",
                                "Miss",
                                "LimitExceeded",
                                "CapacityExceeded",
                                "Error",
                                "Redirect",
                                "LambdaExecutionError",
                                "Unknown",
                                "OriginShieldHit",
                                "MissGeneratedResponse",
                                "AbortedOrigin",
                                "ClientCommError",
                                "ClientGeoBlocked",
                                "ClientHungUpRequest",
                                "InternalError",
                                "InvalidRequest",
                                "InvalidRequestBlocked",
                                "InvalidRequestCertificate",
                                "InvalidRequestHeader",
                                "InvalidRequestMethod",
                                "LambdaLimitExceeded",
                                "OriginCommError",
                                "OriginConnectError",
                                "OriginContentRangeLengthError",
                                "OriginDnsError",
                                "OriginError",
                                "OriginHeaderTooBigError",
                                "OriginInvalidResponseError",
                                "OriginReadError",
                                "OriginWriteError",
                                "OriginZeroSizeObjectError",
                                "SlowReaderOriginError"
                            ]
                        }
                    },
                    "allOf": [
                        {
                            "if": {
                                "properties": {
                                    "response_range_start": {
                                        "type": "null"
                                    }
                                }
                            },
                            "then": {
                                "properties": {
                                    "response_range_end": {
                                        "type": "null"
                                    }
                                }
                            },
                            "else": {
                                "properties": {
                                    "response_range_end": {
                                        "type": "integer"
                                    }
                                }
                            }
                        }
                    ]
                },
                "source_event_id": {
                    "type": "string",
                    "pattern": "^cf:[0-9a-f]{64}$"
                }
            }
        },
        {
            "properties": {
                "type": {
                    "const": "browser_receipt_reported"
                },
                "source": {
                    "enum": [
                        "client"
                    ]
                },
                "payload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "attempt_id",
                        "asset_version_id",
                        "sha256",
                        "bytes_received",
                        "hash_matches"
                    ],
                    "properties": {
                        "attempt_id": {
                            "$ref": "#/$defs/ulid"
                        },
                        "asset_version_id": {
                            "$ref": "#/$defs/ulid"
                        },
                        "sha256": {
                            "$ref": "#/$defs/hash"
                        },
                        "bytes_received": {
                            "$ref": "#/$defs/uint"
                        },
                        "hash_matches": {
                            "$ref": "#/$defs/bool"
                        }
                    }
                }
            }
        },
        {
            "properties": {
                "type": {
                    "const": "preview_reported"
                },
                "source": {
                    "enum": [
                        "client"
                    ]
                },
                "payload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "attempt_id",
                        "asset_version_id",
                        "preview_type"
                    ],
                    "properties": {
                        "attempt_id": {
                            "$ref": "#/$defs/ulid"
                        },
                        "asset_version_id": {
                            "$ref": "#/$defs/ulid"
                        },
                        "preview_type": {
                            "enum": [
                                "png",
                                "jpeg",
                                "text"
                            ]
                        }
                    }
                }
            }
        },
        {
            "properties": {
                "type": {
                    "const": "access_acknowledged"
                },
                "source": {
                    "enum": [
                        "client"
                    ]
                },
                "payload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "voluntary"
                    ],
                    "properties": {
                        "voluntary": {
                            "enum": [
                                true
                            ]
                        }
                    }
                }
            }
        },
        {
            "properties": {
                "type": {
                    "const": "help_requested"
                },
                "source": {
                    "enum": [
                        "client",
                        "app"
                    ]
                },
                "payload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "category"
                    ],
                    "properties": {
                        "category": {
                            "enum": [
                                "access",
                                "file",
                                "payment",
                                "other"
                            ]
                        }
                    }
                }
            }
        },
        {
            "properties": {
                "type": {
                    "const": "transfer_problem_reported"
                },
                "source": {
                    "enum": [
                        "client"
                    ]
                },
                "payload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "attempt_id",
                        "reason"
                    ],
                    "properties": {
                        "attempt_id": {
                            "$ref": "#/$defs/ulid"
                        },
                        "reason": {
                            "enum": [
                                "interrupted",
                                "hash_mismatch",
                                "browser_error",
                                "unknown"
                            ]
                        }
                    }
                }
            }
        }
    ],
    "allOf": [
        {
            "if": {
                "properties": {
                    "sequence": {
                        "const": 1
                    }
                }
            },
            "then": {
                "properties": {
                    "previous_hash": {
                        "type": "null"
                    }
                }
            },
            "else": {
                "properties": {
                    "previous_hash": {
                        "$ref": "#/$defs/hash"
                    }
                }
            }
        }
    ]
}
