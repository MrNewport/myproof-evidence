{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "ulid": {
            "type": "string",
            "minLength": 26,
            "maxLength": 26,
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
        },
        "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "opaque": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        "uint": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
        },
        "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
        },
        "currency_exponent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
        },
        "edge_request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_+=/-]{1,128}$"
        },
        "nullable_uint": {
            "type": [
                "integer",
                "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
        },
        "http_status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
        },
        "edge_status": {
            "oneOf": [
                {
                    "const": 0
                },
                {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                }
            ]
        },
        "bool": {
            "type": "boolean"
        }
    },
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "workspace_id",
        "delivery_id",
        "mode",
        "generated_at",
        "key_id",
        "signature_algorithm",
        "privacy_mode",
        "snapshot_sha256",
        "chain_head",
        "artifacts",
        "coverage"
    ],
    "properties": {
        "schema": {
            "const": "myproof.evidence.v2"
        },
        "workspace_id": {
            "$ref": "#/$defs/ulid"
        },
        "delivery_id": {
            "$ref": "#/$defs/ulid"
        },
        "mode": {
            "enum": [
                "demo",
                "test",
                "live"
            ]
        },
        "generated_at": {
            "$ref": "#/$defs/timestamp"
        },
        "key_id": {
            "$ref": "#/$defs/opaque"
        },
        "signature_algorithm": {
            "const": "Ed25519"
        },
        "privacy_mode": {
            "enum": [
                "masked",
                "full_private"
            ]
        },
        "snapshot_sha256": {
            "$ref": "#/$defs/hash"
        },
        "chain_head": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "sequence",
                "sha256"
            ],
            "properties": {
                "sequence": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                },
                "sha256": {
                    "$ref": "#/$defs/hash"
                }
            }
        },
        "artifacts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "name",
                    "sha256",
                    "size"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}\\.(json|html|pdf|txt)$"
                    },
                    "sha256": {
                        "$ref": "#/$defs/hash"
                    },
                    "size": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 16777216
                    }
                }
            },
            "contains": {
                "properties": {
                    "name": {
                        "const": "snapshot.json"
                    }
                }
            },
            "minContains": 1,
            "maxContains": 1
        },
        "coverage": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "source",
                    "status",
                    "limitation"
                ],
                "properties": {
                    "source": {
                        "enum": [
                            "app",
                            "merchant",
                            "stripe",
                            "ses",
                            "cloudfront",
                            "client"
                        ]
                    },
                    "status": {
                        "enum": [
                            "observed",
                            "pending",
                            "unavailable"
                        ]
                    },
                    "limitation": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                    }
                }
            }
        }
    },
    "title": "MyProof evidence v2 manifest"
}
